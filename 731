#include <bits/stdc++.h>
using namespace std;
int main()
{
    int n;
    cin>>n;
    map<string,int>counts;
    for(int i=0;i<n;i++){
        string country,name;
        cin>>country;
        getline(cin,name);
        counts[country]++;
    }
    for(pair<string,int>item:counts){
        cout<<item.first<<" "<<item.second<<endl;
    }
    return 0;
}