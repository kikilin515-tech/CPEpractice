#include <bits/stdc++.h>
using namespace std;
int main()
{
    string s1,s2,s;
    while(getline(cin,s1),getline(cin,s2)){
        for(int i=0;i<s1.length();i++){
            for(int j=0;j<s2.length();j++){
                if(s1[i]==s2[j]){
                    s=s+s1[i];
                    s1.erase(i,1);//避免字母重複算入
                    s2.erase(j,1);
                }
            }
        }
        sort(s.begin(),s.end());//排列字串ASCII從小到大
        cout<<s<<endl;
        s1.clear(),s2.clear(),s.clear();//清空上一輪可能殘留的文字
    }
    return 0;
}